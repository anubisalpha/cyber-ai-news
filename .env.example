# Copy to .env and fill in. Used by docker run (-e / --env-file) and docker compose.

# ---- Built-in basic auth (optional) ------------------------------------
# Set BOTH to enable the app's own HTTP basic auth on all routes.
# /api/health is always open so healthcheck probes work without credentials.
# Leave blank if you're putting a reverse proxy (Caddy, nginx, ALB) in front
# that handles auth itself.
AUTH_USER=
AUTH_PASS=

# ---- Reverse proxy (Caddy — only needed if using compose.yml with Caddy) ---
# Generate the bcrypt hash. docker compose treats "$" as a variable,
# so every "$" must be DOUBLED to "$$" in this file. One-liner that does both:
#   docker run --rm caddy caddy hash-password --plaintext 'yourpass' | sed 's/\$/\$\$/g'
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=

# What Caddy listens on. Default is plain HTTP on :8080.
# For automatic HTTPS set this to a hostname (e.g. news.example.com) and also
# publish 80:80 and 443:443 in compose.yml.
SITE_ADDRESS=http://:8080

# ---- Email (digest + alerts) -------------------------------------------
# Option A — internal SMTP relay (no credentials required):
SMTP_HOST=172.16.2.25
SMTP_PORT=25
SMTP_FROM=claude_ai@welfarecall.com
# SMTP_USER and SMTP_PASS can be omitted for unauthenticated relays.

# Option B — external SMTP with authentication (e.g. Gmail app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraccount@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=youraccount@gmail.com
# SMTP_SSL=true    # set for implicit SSL (port 465); default is STARTTLS

MAIL_TO=you@example.com    # default digest/alert recipient

# ---- Optional LLM fallback classifier ----------------------------------
# Only used if installed (requirements-llm.txt) AND enabled in settings.yaml.
GOOGLE_API_KEY=
