# Copy to .env and fill in. Used by docker compose (env_file).

# ---- Reverse proxy + basic auth (REQUIRED for the caddy proxy) ---------
# The app is only reachable through the Caddy proxy, which enforces basic auth.
#
# Generate the bcrypt hash. IMPORTANT: docker compose treats "$" as a variable,
# so the hash must have every "$" DOUBLED to "$$" in this file. This one-liner
# does both (generate + escape) — paste its output as BASIC_AUTH_HASH:
#   docker run --rm caddy caddy hash-password --plaintext 'your-password' | sed 's/\$/\$\$/g'
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=

# What Caddy listens on. Default is plain HTTP on :8080.
# For automatic HTTPS, set this to your hostname (e.g. news.example.com) and
# also publish 80:80 and 443:443 in compose.yml.
SITE_ADDRESS=http://:8080

# ---- Everything below is OPTIONAL --------------------------------------
# These only enable email (digest/alerts) and the LLM classifier.

# ---- Email (digest + alerts) -------------------------------------------
# If SMTP_HOST is set, email is sent directly from the container.
# Example below is Gmail with an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=youraccount@gmail.com
# SMTP_SSL=true          # set for implicit SSL (port 465); default is STARTTLS
MAIL_TO=you@example.com  # default digest/alert recipient

# ---- Optional LLM fallback classifier ----------------------------------
# Only used if installed (requirements-llm.txt) AND enabled in settings.yaml.
GOOGLE_API_KEY=
